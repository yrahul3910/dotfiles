[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
Environment=DISPLAY=:0
Type=simple
# kanata comes from the Brewfile; %h is the user's home directory.
ExecStart=/home/linuxbrew/.linuxbrew/bin/kanata --cfg %h/.config/kanata/config.kbd
Restart=no

[Install]
WantedBy=default.target
