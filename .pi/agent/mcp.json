{
  "mcpServers": {
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "url": "https://mcp.linear.app/mcp",
      "auth": { "type": "oauth" }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.firecrawl.dev/v2/mcp-oauth"],
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth",
      "auth": { "type": "oauth" },
      "lifecycle": "eager"
    }
  }
}
