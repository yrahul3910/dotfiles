{
  // Redesigned bash permission format (pi-permission-system 0.8.0-patch.2).
  // Rules are word-prefix lists matched per executed command; read-only
  // commands (rg, grep, cat, git log, ...) are allowed by the built-in
  // safe-command registry, and .env/.ssh/key files are denied by built-in
  // protected paths — no per-command deny globs needed anymore.
  "bash": {
    "allow": [
      "cargo clippy",
      "cargo check",
      "cargo fmt",
      "cargo test",
      "bun test",
      "uv run pytest",
      "uv run pyright",
      "uv run ruff check",
      "uv run ruff format",
      "gh run view",
      "no-sloppy",
    ],
    "registryOverrides": {
      "jj": {
        "safeSubcommands": ["bookmark list", "diff", "file list", "file show", "log", "op log", "show", "status"],
        "unsafeArgs": ["--config", "--config-toml", "--config-file"]
      }
    }
  },
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask",
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "ask_user": "allow",
    "bg_start": "allow",
    "bg_status": "allow",
  },
}
