{
  // Redesigned bash permission format (pi-permission-system 0.8.0-patch.2).
  // Rules are word-prefix lists matched per executed command; read-only
  // commands (rg, grep, cat, git log, ...) are allowed by the built-in
  // safe-command registry, and .env/.ssh/key files are denied by built-in
  // protected paths — no per-command deny globs needed anymore.
  "bash": {
    "allow": [
      "cargo clippy",
      "cargo check",
      "cargo fmt",
      "bun test",
      "uv run pytest",
      "uv run pyright",
      "uv run ruff check",
      "uv run ruff format",
      "gh run view",
      "no-sloppy",
      "anti-slop",
    ],
    "registryOverrides": {
      "jj": {
        "safeSubcommands": [
          "bookmark list",
          "diff",
          "file list",
          "file show",
          "log",
          "op log",
          "show",
          "status",
        ],
        "unsafeArgs": ["--config", "--config-toml", "--config-file"],
      },
    },
  },
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "allow",
    "special": "ask",
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "ask_user": "allow",
    "bg_start": "allow",
    "bg_status": "allow",
    "get_subagent_result": "allow",
    "steer_subagent": "allow",
    "set_reasoning_effort": "allow",
    "mcp_firecrawl_firecrawl_search": "allow",
    "mcp_firecrawl_firecrawl_scrape": "allow",
    "Agent": "allow",
  },
}
