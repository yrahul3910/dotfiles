{
  "lastChangelogVersion": "1.0.2",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "editorPaddingX": 0,
  "promptHistoryScope": "project",
  "recapIdleMinutes": 5,
  "transport": "auto",
  "retry": {
    "enabled": true,
    "maxRetries": 2,
    "baseDelayMs": 1000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 5000
    }
  },
  "packages": [
    "npm:@tintinweb/pi-subagents",
    "git:github.com/yrahul3910/pi-permission-system",
    "npm:pi-lsp-extension"
  ],
  "theme": "light/dark",
  "quietStartup": false,
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "steeringMode": "all",
  "tuiMode": "fullscreen"
}