{
  "profile": "local",
  "profiles": {
    "local": {
      "provider": {
        "type": "openai-compatible",
        "endpoint": "http://127.0.0.1:8080/v1/audio/transcriptions",
        "model": "parakeet"
      }
    },
    "openrouter": {
      "provider": {
        "type": "openai-compatible",
        "endpoint": "https://openrouter.ai/api/v1/audio/transcriptions",
        "model": "microsoft/mai-transcribe-2",
        "apiKeyEnv": "OPENROUTER_API_KEY",
        "language": "en"
      }
    }
  }
}
